# Copy to .env and adjust. Read by docker compose and by the backend when run locally.

# --- Database -------------------------------------------------------------------------
# Default: SQLite (backend/data/jacklyn.db locally, the jacklyn-data volume in Docker).
# PostgreSQL (start compose with --profile postgres):
# DATABASE_URL=postgresql+psycopg://jacklyn:change-me@postgres:5432/jacklyn
# POSTGRES_PASSWORD=change-me

# --- App ------------------------------------------------------------------------------
# JACKLYN_DEFAULT_BASE_CURRENCY=CHF
# Seed the demo portfolio on first start (set false for a clean install).
# JACKLYN_SEED_DEMO_DATA=true

# --- Market data ----------------------------------------------------------------------
# Live quotes + FX via yfinance, cached in the database. Set false for fully offline use.
# JACKLYN_LIVE_MARKET_DATA=true
# JACKLYN_MARKET_DATA_TTL_SECONDS=900

# --- Uploads / web --------------------------------------------------------------------
# JACKLYN_MAX_UPLOAD_MB=20
# Host port for the web UI in Docker.
# JACKLYN_PORT=8080
