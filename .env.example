# Copy to .env and adjust. Read by docker compose and by the backend when run locally.

# --- Network exposure -------------------------------------------------------------------
# The web UI is published on 127.0.0.1 only: nothing is reachable from your LAN or the internet.
# Set 0.0.0.0 for LAN access (only on a network you trust). Cloudflare Tunnel needs no ports at all.
# JACKLYN_BIND=127.0.0.1
# JACKLYN_PORT=8080

# Cloudflare Tunnel (docker compose --profile tunnel up -d). See docs/cloudflare-tunnel.md.
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Security ---------------------------------------------------------------------------
# Encrypts 2FA secrets and broker API tokens at rest. If unset, one is generated into the data
# volume (data/secret.key) - back it up together with the database.
# JACKLYN_SECRET_KEY=
# Secure cookies: "auto" uses them whenever the request arrived over HTTPS (Cloudflare does that).
# JACKLYN_COOKIE_SECURE=auto
# JACKLYN_SESSION_DAYS=30
# JACKLYN_LOCKOUT_THRESHOLD=5
# JACKLYN_LOCKOUT_MINUTES=15

# --- Database ---------------------------------------------------------------------------
# Default: SQLite (backend/data/jacklyn.db locally, the jacklyn-data volume in Docker).
# PostgreSQL (start compose with --profile postgres):
# DATABASE_URL=postgresql+psycopg://jacklyn:change-me@postgres:5432/jacklyn
# POSTGRES_PASSWORD=change-me

# --- App --------------------------------------------------------------------------------
# JACKLYN_DEFAULT_BASE_CURRENCY=CHF
# Seed a demo portfolio for the admin before first-run setup (setup lets you drop it).
# JACKLYN_SEED_DEMO_DATA=true

# --- Market data ------------------------------------------------------------------------
# Live quotes + FX via yfinance, cached in the database. Set false for fully offline use.
# JACKLYN_LIVE_MARKET_DATA=true
# JACKLYN_MARKET_DATA_TTL_SECONDS=900

# --- Uploads ----------------------------------------------------------------------------
# JACKLYN_MAX_UPLOAD_MB=20
