# Copy to .env (used by docker compose and the backend).

# SQLite (default). Inside docker the file lives on the jacklyn-data volume.
# JACKLYN_DATABASE_URL=sqlite:////data/jacklyn.db

# PostgreSQL via `docker compose --profile postgres up`:
# JACKLYN_DATABASE_URL=postgresql+psycopg://jacklyn:jacklyn@db:5432/jacklyn
# POSTGRES_PASSWORD=jacklyn

JACKLYN_SEED_ON_STARTUP=true
JACKLYN_DEFAULT_USER_EMAIL=demo@jacklyn.local
JACKLYN_DEFAULT_BASE_CURRENCY=CHF

# Host ports
JACKLYN_WEB_PORT=8080
JACKLYN_API_PORT=8000
